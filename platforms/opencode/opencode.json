{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "opencode/rules/common.md",
    "opencode/rules/java.md",
    "opencode/rules/typescript.md",
    "opencode/rules/vue.md",
    "opencode/rules/react.md",
    "opencode/rules/react-native.md",
    "opencode/rules/web.md",
    "shared/skills/workflow-triggers/SKILL.md",
    "shared/skills/verification-gate/SKILL.md",
    "shared/skills/code-review-gate/SKILL.md",
    "shared/skills/scope-check/SKILL.md",
    "shared/skills/requirements-refinement/SKILL.md",
    "shared/skills/plan-workflow/SKILL.md",
    "shared/skills/implement-feature/SKILL.md",
    "shared/skills/build-fix/SKILL.md",
    "shared/skills/tdd-workflow/SKILL.md",
    "shared/skills/eval-harness/SKILL.md",
    "shared/skills/frontend-patterns/SKILL.md",
    "shared/skills/backend-patterns/SKILL.md",
    "shared/skills/api-design/SKILL.md",
    "shared/skills/security-review/SKILL.md"
  ],
  "skills": {
    "paths": ["shared/skills"]
  },
  "agent": {
    "build": { "description": "Primary development agent for coding, debugging, and implementation", "mode": "primary", "prompt": "{file:agents/build.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "planner": { "description": "Create detailed implementation plans for complex features or refactoring", "mode": "subagent", "prompt": "{file:agents/planner.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "architect": { "description": "Software architecture specialist for system design and scalability", "mode": "subagent", "model": "claude-opus-4-5", "prompt": "{file:agents/architect.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "code-reviewer": { "description": "Expert code review - quality, security, maintainability", "mode": "subagent", "prompt": "{file:agents/code-reviewer.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "tdd-guide": { "description": "Test-Driven Development - write tests first, then implement", "mode": "subagent", "prompt": "{file:agents/tdd-guide.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "security-reviewer": { "description": "Security vulnerability detection and remediation", "mode": "subagent", "prompt": "{file:agents/security-reviewer.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "backend-dev": { "description": "Backend engineer - Spring Boot, database, API controllers", "mode": "subagent", "prompt": "{file:agents/backend-dev.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "frontend-dev": { "description": "Frontend developer - React/Vue with TypeScript", "mode": "subagent", "prompt": "{file:agents/frontend-dev.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "frontend-rn-dev": { "description": "React Native / Expo mobile developer", "mode": "subagent", "prompt": "{file:agents/frontend-rn-dev.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "frontend-vue-dev": { "description": "Vue frontend developer", "mode": "subagent", "prompt": "{file:agents/frontend-vue-dev.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "build-error-resolver": { "description": "Build and type error resolution specialist", "mode": "subagent", "prompt": "{file:agents/build-error-resolver.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "e2e-runner": { "description": "End-to-end testing with Playwright", "mode": "subagent", "prompt": "{file:agents/e2e-runner.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "refactor-cleaner": { "description": "Dead code cleanup and consolidation", "mode": "subagent", "prompt": "{file:agents/refactor-cleaner.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "database-reviewer": { "description": "PostgreSQL and database migration specialist", "mode": "subagent", "prompt": "{file:agents/database-reviewer.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "doc-updater": { "description": "Documentation and codemap specialist", "mode": "subagent", "prompt": "{file:agents/doc-updater.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "qa-engineer": { "description": "QA test engineer for test design", "mode": "subagent", "prompt": "{file:agents/qa-engineer.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": false } },
    "a11y-architect": { "description": "Accessibility architect for WCAG compliance", "mode": "subagent", "prompt": "{file:agents/a11y-architect.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "code-explorer": { "description": "Deep codebase analysis and tracing", "mode": "subagent", "prompt": "{file:agents/code-explorer.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "code-simplifier": { "description": "Code simplification and readability", "mode": "subagent", "prompt": "{file:agents/code-simplifier.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "product-manager": { "description": "Product manager for requirements gathering", "mode": "subagent", "prompt": "{file:agents/product-manager.txt}", "tools": { "read": true, "bash": false, "write": false, "edit": false } },
    "doc-sync": { "description": "Documentation synchronization specialist", "mode": "subagent", "prompt": "{file:agents/doc-sync.txt}", "tools": { "read": true, "bash": true, "write": true, "edit": true } },
    "java-reviewer": { "description": "Java and Spring Boot code review", "mode": "subagent", "prompt": "{file:agents/java-reviewer.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "react-reviewer": { "description": "React code review specialist", "mode": "subagent", "prompt": "{file:agents/react-reviewer.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "vue-reviewer": { "description": "Vue code review specialist", "mode": "subagent", "prompt": "{file:agents/vue-reviewer.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "typescript-reviewer": { "description": "TypeScript/JavaScript code review", "mode": "subagent", "prompt": "{file:agents/typescript-reviewer.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } },
    "pr-test-analyzer": { "description": "PR test coverage impact analysis", "mode": "subagent", "prompt": "{file:agents/pr-test-analyzer.txt}", "tools": { "read": true, "bash": true, "write": false, "edit": false } }
  },
  "command": {
    "plan": { "description": "Create implementation plan", "template": "{file:commands/plan.md}\n\n$ARGUMENTS", "agent": "planner", "subtask": true },
    "tdd": { "description": "Test-driven development workflow", "template": "{file:commands/tdd.md}\n\n$ARGUMENTS", "agent": "tdd-guide", "subtask": true },
    "code-review": { "description": "Review code quality", "template": "{file:commands/code-review.md}\n\n$ARGUMENTS", "agent": "code-reviewer", "subtask": true },
    "security": { "description": "Security vulnerability check", "template": "{file:commands/security.md}\n\n$ARGUMENTS", "agent": "security-reviewer", "subtask": true },
    "build-fix": { "description": "Fix build/type errors", "template": "{file:commands/build-fix.md}\n\n$ARGUMENTS", "agent": "build-error-resolver", "subtask": true },
    "e2e": { "description": "Run end-to-end tests", "template": "{file:commands/e2e.md}\n\n$ARGUMENTS", "agent": "e2e-runner", "subtask": true },
    "refactor": { "description": "Clean up dead code", "template": "{file:commands/refactor.md}\n\n$ARGUMENTS", "agent": "refactor-cleaner", "subtask": true },
    "verify": { "description": "Run delivery verification gate", "template": "{file:commands/verify.md}\n\n$ARGUMENTS", "agent": "build", "subtask": true },
    "update-docs": { "description": "Update docs and codemaps", "template": "{file:commands/update-docs.md}\n\n$ARGUMENTS", "agent": "doc-updater", "subtask": true }
  }
}
